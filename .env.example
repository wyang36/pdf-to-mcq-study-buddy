# ---------------------------------------------------------------------------
# LLM provider configuration
#
# LLM_PROVIDER selects which model powers planning + MCQ generation + hints.
#   "anthropic" -> uses ANTHROPIC_API_KEY
#   "openai"    -> uses OPENAI_API_KEY
#   "mock"      -> no API key needed; deterministic heuristic content so you
#                  can run and demo the entire flow offline.
#
# If LLM_PROVIDER is unset, the app auto-detects: it uses "anthropic" if
# ANTHROPIC_API_KEY is set, else "openai" if OPENAI_API_KEY is set, else "mock".
# ---------------------------------------------------------------------------
LLM_PROVIDER=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides (sensible defaults are used if omitted)
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_MODEL=gpt-4o
