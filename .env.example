# ---------------------------------------------------------------------------
# LLM configuration — a fallback CHAIN, tried in order for every generation.
#
# Auto-detected default order (only providers whose key is set are used):
#   Gemini  ->  OpenRouter (free)  ->  Anthropic  ->  OpenAI  ->  mock
#
# If a model errors (bad key, rate limit, unsupported output), the next one in
# the chain is tried; if all fail, a deterministic offline "mock" is used so the
# app always works. The active chain is shown in the app header.
#
# Recommended setup for this project: Gemini as primary + a free OpenRouter
# model as automatic backup.
# ---------------------------------------------------------------------------

# --- Primary: Google Gemini -------------------------------------------------
# Get a key at https://aistudio.google.com/apikey  (free tier available)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash          # optional override

# --- Backup: OpenRouter (free models) ---------------------------------------
# Get a key at https://openrouter.ai/keys
# Browse free models at https://openrouter.ai/collections/free-models
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free   # optional override

# --- Optional additional providers ------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_MODEL=gpt-4o

# --- Advanced: pin the chain explicitly (otherwise auto-detected) -----------
# LLM_PROVIDER selects a single primary: gemini | openrouter | anthropic | openai | mock
# LLM_FALLBACK_PROVIDER selects one backup (only used when LLM_PROVIDER is set).
# LLM_PROVIDER=gemini
# LLM_FALLBACK_PROVIDER=openrouter
